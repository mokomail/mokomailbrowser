{
  "name": "mokomail-browser",
  "productName": "MokomailBrowser",
  "version": "1.0.0",
  "description": "MokomailBrowser — современный браузер на базе Chromium (Electron) в оформлении Material 3: мастер первого запуска, вкладки и группы, плагины, профили, режим инкогнито, омнибокс, закладки, полная история в JSON, загрузки и большое количество настроек.",
  "main": "src/main/main.js",
  "author": "MokomailTeam (https://github.com/mokomail)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoketest": "electron . --smoketest",
    "clean:data": "node scripts/clean-browser-data.js",
    "predist": "node scripts/clean-browser-data.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "keywords": [
    "browser",
    "electron",
    "chromium",
    "webview"
  ],
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mokomail.browser",
    "productName": "MokomailBrowser",
    "copyright": "Copyright © 2026 MokomailTeam",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md",
      "!docs/**/*",
      "!scripts/**/*",
      "!.npmrc",
      "!.gitignore"
    ],
    "win": {
      "icon": "icons/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MokomailBrowser",
      "artifactName": "${productName}-${version}-setup.${ext}",
      "uninstallDisplayName": "MokomailBrowser ${version}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
