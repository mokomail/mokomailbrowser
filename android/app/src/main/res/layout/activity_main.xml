<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Верхняя зона: только адресная строка (Material 3 pill), без названия и логотипа -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/incognitoChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_incognito"
            android:drawablePadding="6dp"
            android:drawableTint="?attr/colorOnTertiaryContainer"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/incognito_chip"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/omniboxCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/omniboxIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <EditText
                    android:id="@+id/omnibox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/omnibox_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/starButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/action_bookmark"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_star"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reloadButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/action_reload"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_reload"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceContainerHighest"
        app:trackThickness="3dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/webContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:elevation="3dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_back"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_back"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forwardButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_forward"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_forward"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_home"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_home"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabsButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_tabs"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_tab"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp" />

            <TextView
                android:id="@+id/tabsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="18dp"
                android:minHeight="18dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="1"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@string/action_menu"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_more"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
